# Copy this file to .env and adjust the values. Every service reads it.

# Ports exposed on your machine
BACKEND_PORT=8010
FRONTEND_PORT=4210
DB_PORT=5440

# PostgreSQL
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tender

# Database used when the backend runs outside Docker (uses DB_PORT).
# Inside Docker Compose the backend reaches the database through the "db" service.
DATABASE_URL=postgres://tender:tender@localhost:5440/tender

# Chat model: anthropic or ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional Langfuse tracing. Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4210,http://localhost:4200
REVIEWS_MAX_CONCURRENCY=4
LOG_LEVEL=INFO
